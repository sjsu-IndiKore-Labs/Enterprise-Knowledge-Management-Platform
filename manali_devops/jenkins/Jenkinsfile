// Jenkins pipeline for EKM (course requirement alongside GitHub Actions). Owner: Manali.
// Job config: Pipeline from SCM, Script Path = manali_devops/jenkins/Jenkinsfile.
// Agent needs: docker (with buildx), aws CLI v2, jq, node 20 (npx), python3.
// AWS access: an instance profile / credentials with the same permissions as the GitHub deploy role.
// See manali_devops/docs/ci-cd.md for running Jenkins locally in Docker.
pipeline {
  agent any
  parameters {
    booleanParam(name: 'DEPLOY', defaultValue: false, description: 'Push images and deploy to ECS staging (main branch only)')
  }
  environment {
    AWS_REGION  = 'us-west-2'
    ENVIRONMENT = 'staging'
    PLATFORM    = 'linux/amd64'
  }
  options {
    timestamps()
    timeout(time: 60, unit: 'MINUTES')
    disableConcurrentBuilds()
  }
  stages {
    stage('Contracts') {
      steps { sh 'make lint-contracts' }
    }
    stage('DevOps checks') {
      parallel {
        stage('compose') { steps { sh 'docker compose --profile apps --profile mocks config -q' } }
        stage('config tests') {
          steps {
            sh 'python3 -m venv .ci-venv && .ci-venv/bin/pip install -q -r manali_devops/tests/requirements.txt'
            sh '.ci-venv/bin/pytest manali_devops/tests -m "not integration" -q --junitxml=reports/devops-unit.xml'
          }
        }
      }
    }
    stage('Build & test services') {
      parallel {
        stage('backend') {
          when { expression { fileExists('ayushi_backend/pom.xml') } }
          steps { dir('ayushi_backend') { sh 'bash ./mvnw clean package -DskipTests' } }
        }
        stage('frontend') {
          when { expression { fileExists('changhyun_frontend/package.json') } }
          steps { dir('changhyun_frontend') { sh 'corepack enable && pnpm install --frozen-lockfile && pnpm lint && pnpm build' } }
        }
        stage('ai') {
          when { expression { fileExists('vedanti_ai/pyproject.toml') } }
          steps { dir('vedanti_ai') { sh 'python3 -m venv .venv && .venv/bin/pip install -e ".[dev]" && AI_PROVIDER=fake .venv/bin/pytest -q' } }
        }
      }
    }
    stage('Docker images') {
      steps { sh 'manali_devops/tests/docker/test_images.sh && REAL=1 manali_devops/tests/docker/test_images.sh' }
    }
    stage('Push to ECR') {
      when { allOf { branch 'main'; expression { params.DEPLOY } } }
      steps {
        script {
          env.IMAGE_TAG = sh(script: 'git rev-parse HEAD', returnStdout: true).trim()
          def account = sh(script: 'aws sts get-caller-identity --query Account --output text', returnStdout: true).trim()
          env.ECR_REGISTRY = "${account}.dkr.ecr.${env.AWS_REGION}.amazonaws.com"
        }
        sh 'aws ecr get-login-password --region $AWS_REGION | docker login --username AWS --password-stdin $ECR_REGISTRY'
        sh 'manali_devops/scripts/build-push.sh $ENVIRONMENT $IMAGE_TAG | tee build.log'
      }
    }
    stage('Deploy to ECS') {
      when { allOf { branch 'main'; expression { params.DEPLOY } } }
      steps {
        sh '''
          services=""
          for s in $(grep '^PUSHED:' build.log | cut -d' ' -f2-); do
            services="$services $s"; [ "$s" = ai-service ] && services="$services ai-worker"
          done
          manali_devops/scripts/ecs-deploy.sh $ENVIRONMENT $IMAGE_TAG $services
        '''
      }
    }
  }
  post {
    always {
      junit allowEmptyResults: true, testResults: 'reports/*.xml'
    }
  }
}
