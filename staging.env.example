# Runtime configuration for AWS staging.
# This file contains names and non-secret settings only. Do not add credentials or secrets.
# ECS task roles provide AWS access; runtime secrets belong in AWS Secrets Manager.

APP_ENV=staging
LOG_LEVEL=INFO
LOG_FORMAT=json

# AWS / staging resources
AWS_REGION=us-west-2
AWS_ENDPOINT_URL=
S3_DOCUMENTS_BUCKET=ekm-documents-staging
SQS_DOCUMENT_INGEST_QUEUE=ekm-staging-document-ingest
SQS_DOCUMENT_STATUS_QUEUE=ekm-staging-document-status
SQS_AUDIT_EVENTS_QUEUE=ekm-staging-audit-events

# Database connection values are supplied by the ECS task definition / Secrets Manager.
POSTGRES_HOST=
POSTGRES_PORT=5432
POSTGRES_DB=ekm
POSTGRES_USER=ekm
POSTGRES_PASSWORD=

# Service configuration
CORE_API_PORT=8080
AUDIT_SERVICE_PORT=8081
AI_SERVICE_PORT=8000
AI_SERVICE_URL=
CORS_ALLOWED_ORIGINS=

# Secret-backed values must be injected by ECS from AWS Secrets Manager.
JWT_SECRET=
INTERNAL_SERVICE_TOKEN=
OPENAI_API_KEY=
AI_PROVIDER=openai
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
