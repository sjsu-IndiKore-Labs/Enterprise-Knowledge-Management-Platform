# Copy to .env.local for local development. Only NEXT_PUBLIC_* values reach the browser.
# Prism mock:   make mock-core-api   (repo root)  ->  http://localhost:4010
# Real backend: core-api              ->  http://localhost:8080
NEXT_PUBLIC_API_BASE_URL=http://localhost:4010
NEXT_PUBLIC_APP_NAME=Helios Knowledge Portal
NEXT_PUBLIC_MAX_UPLOAD_MB=25
