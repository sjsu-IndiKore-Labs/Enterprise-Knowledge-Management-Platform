# =============================================================================
# .env.example — the ONLY list of environment variable names used in this project.
# Copy to .env (git-ignored) and fill in. Do not invent new names in code:
# add them here first (shared-file PR) and log it in contracts/CHANGELOG.md.
#
# Values below are for LOCAL development (docker-compose + LocalStack).
# Inside docker-compose, hostnames are service names (postgres, localstack, core-api, ai-service);
# docker-compose.yml overrides the *_HOST / *_URL values for containers automatically.
# =============================================================================

# ---- General ----------------------------------------------------------------
APP_ENV=local                          # local | dev | staging | prod
LOG_LEVEL=INFO
LOG_FORMAT=json                        # json (default, CloudWatch-friendly) | text

# ---- PostgreSQL + pgvector (owner: Ayushi, used by core-api, audit-service, ai-service)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=ekm
POSTGRES_USER=ekm
POSTGRES_PASSWORD=ekm_local_password

# ---- AWS / LocalStack (owner: Manali) ----------------------------------------
AWS_REGION=us-west-2
AWS_ENDPOINT_URL=http://localhost:4566 # LOCAL ONLY. Leave empty in AWS so SDKs use real endpoints.
AWS_ACCESS_KEY_ID=test                 # LOCAL ONLY (LocalStack accepts anything). In AWS use IAM task roles.
AWS_SECRET_ACCESS_KEY=test
S3_DOCUMENTS_BUCKET=ekm-documents-local
SQS_DOCUMENT_INGEST_QUEUE=ekm-document-ingest   # core-api  -> ai-service
SQS_DOCUMENT_STATUS_QUEUE=ekm-document-status   # ai-service -> core-api
SQS_AUDIT_EVENTS_QUEUE=ekm-audit-events         # core-api  -> audit-service
# Services resolve queue URLs by name via GetQueueUrl; never hard-code queue URLs.

# ---- Auth (owner: Ayushi) -----------------------------------------------------
JWT_SECRET=local-dev-jwt-secret-change-me-must-be-at-least-32-bytes
JWT_ISSUER=ekm-core-api
JWT_EXPIRATION_MINUTES=60
INTERNAL_SERVICE_TOKEN=local-internal-token-change-me   # core-api -> ai-service header X-Internal-Token
CORS_ALLOWED_ORIGINS=http://localhost:3000

# ---- Service URLs ---------------------------------------------------------------
CORE_API_PORT=8080
AUDIT_SERVICE_PORT=8081
AI_SERVICE_PORT=8000
AI_SERVICE_URL=http://localhost:8000           # used by core-api
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080 # used by the browser (web). Use http://localhost:4010 for the Prism mock.

# ---- AI / RAG (owner: Vedanti) ---------------------------------------------------
AI_PROVIDER=openai                     # openai | fake   (fake = deterministic offline embeddings + canned answers, no key needed)
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536              # MUST match vector(1536) in contracts/database/migrations
CHUNK_SIZE_TOKENS=500
CHUNK_OVERLAP_TOKENS=80
RAG_TOP_K=6
RAG_MIN_SIMILARITY=0.35                # below this best-score the answer is "not found" -> knowledge gap
RAG_HYBRID_SEMANTIC_WEIGHT=0.7         # final = w*semantic + (1-w)*keyword
EMBEDDING_CACHE_TTL_SECONDS=3600

# ---- Frontend (owner: Changhyun) -------------------------------------------------
NEXT_PUBLIC_APP_NAME=Helios Knowledge Portal
NEXT_PUBLIC_MAX_UPLOAD_MB=25
